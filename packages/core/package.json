    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@vitest/browser": "^4.1.4",
    "jsdom": "^29.0.2",
    "rollup": "^4.34.9",
    "rollup-plugin-glsl": "^1.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
