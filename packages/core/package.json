{
  "name": "@kineticos/core",
  "version": "1.3.5",
  "description": "WebGL canvas effects for Webflow and any HTML platform. Attribute-driven. Zero config to full control.",
  "type": "module",
  "main": "dist/kineticos.min.js",
  "module": "dist/kineticos.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/kineticos.min.js",
    "./effects/*": "./dist/effects/*/index.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wripcode/KineticOS.git",
    "directory": "packages/core"
  },
  "keywords": [
    "webflow",
    "framer",
    "html",
    "webgl",
    "animation",
    "canvas",
    "dots",
    "particles",
    "shader",
    "interactive",
    "physics",
    "mouse-tracking",
    "cdn"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js --watch",
    "analyze": "ANALYZE=true rollup -c rollup.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@vitest/browser": "^4.1.4",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.0.2",
    "rollup": "^4.34.9",
    "rollup-plugin-glsl": "^1.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
