{
  "name": "@kineticos/core",
  "version": "1.0.0",
  "description": "WebGL canvas effects for Webflow and any HTML platform. Attribute-driven. Zero config to full control.",
  "type": "module",
  "main": "dist/kineticos.iife.min.js",
  "module": "dist/kineticos.min.js",
  "types": "dist/kineticos.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wripcode/KineticOS.git",
    "directory": "packages/core"
  },
  "keywords": [
    "webflow",
    "webgl",
    "animation",
    "canvas",
    "dots",
    "particles",
    "cdn"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js --watch",
